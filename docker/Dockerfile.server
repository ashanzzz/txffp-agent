# Multi-stage Dockerfile: Unified Backend & WebUI for txffp-agent

# Stage 1: Build React Frontend
FROM node:20-alpine AS web-builder

WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm install

COPY web/ ./
RUN npm run build

# Stage 2: Build Rust Backend
FROM rust:bookworm AS builder

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY server/Cargo.toml ./server/Cargo.toml

# Cache dependencies
RUN mkdir -p server/src && echo "fn main() {}" > server/src/main.rs && echo "" > server/src/lib.rs
RUN cargo build --release || true

# Copy source code and build
COPY server/src ./server/src
RUN touch server/src/main.rs server/src/lib.rs
RUN cargo build --release -p txffp-server

# Stage 3: Unified Runtime Image
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/txffp-server /usr/local/bin/txffp-server
COPY --from=web-builder /web/dist /app/dist

RUN mkdir -p /data

ENV PORT=8000
ENV HOST=0.0.0.0
ENV DATA_DIR=/data
ENV DATABASE_URL=sqlite:///data/txffp.db

VOLUME ["/data"]
EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/txffp-server"]
