# Server Configuration
PORT=8000
HOST=0.0.0.0
TXFFP_API_TOKEN=

# Database Configuration
DATABASE_URL=sqlite:///data/txffp.db

# Txffp Credentials (Optional - can also be configured via Frontend or /data/secrets.toml)
TXFFP_USERNAME=
TXFFP_PASSWORD=
TXFFP_PHONE=

# Authentication Mode: auto | manual | hybrid (default: hybrid)
TXFFP_AUTH_MODE=hybrid
TXFFP_AUTO_LOGIN=true
TXFFP_MAX_AUTH_ATTEMPTS=3

# External Services
STEEL_BASE_URL=http://192.168.8.11:13000
SCRAPLING_BASE_URL=http://192.168.8.11:8111
SCRAPLING_MCP_AUTH_TOKEN=

# Research Mode (default: false, set to true to capture anonymized research dumps)
TXFFP_RESEARCH_MODE=false
